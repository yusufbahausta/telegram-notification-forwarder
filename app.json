{
  "expo": {
    "name": "Telegram Bildirim Yönlendirici",
    "slug": "telegram-notification-forwarder",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.telegram.notificationforwarder",
      "permissions": [
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-dev-client"
    ]
  }
}
