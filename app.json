{
  "expo": {
    "name": "Telegram Bildirim Yönlendirici",
    "slug": "telegram-notification-forwarder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.telegram.notificationforwarder",
      "permissions": [
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      }
    },
    "plugins": [
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "c7d8ba92-aa7a-4ced-b639-4df9ac21be90"
      }
    }
  }
}
